{
  "name": "ppxt-compiler",
  "version": "0.2.0",
  "private": true,
  "description": "Compiles a brief into a .pptx: an LLM plans and writes, a deterministic engine lays out and renders, and a rubric checks quality.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "generate:sample": "tsx src/index.ts data/examples/briefing.sample.json",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "jszip": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.0"
  }
}
